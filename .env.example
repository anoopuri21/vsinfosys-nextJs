# VS Infosys — central environment template
# Copy to .env.local for local development. Never commit real values.

# Public website / CMS read API
NEXT_PUBLIC_SITE_URL=https://vsinfosys.in
NEXT_PUBLIC_CONTENT_API_ORIGIN=https://api.vsinfosys.in
NEXT_PUBLIC_CMS_API_ORIGIN=https://admin.vsinfosys.in
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Worker secrets — set with `wrangler secret put`, not in browser builds
# ADMIN_SHARED_SECRET=
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUDIENCE=
# TURNSTILE_SECRET_KEY=
# RESEND_API_KEY=
# ENQUIRY_NOTIFICATION_EMAIL=

# Analytics / monitoring — only enable after consent and verified account setup
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# SENTRY_DSN=
